---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Lines from '../components/Lines.astro';
import Placeholder from '../components/Placeholder.astro';
import { photographs } from '../data/photography';
import { photographImage } from '../lib/images';

// Only photographs whose file exists are shown.
const items = await Promise.all(
  photographs.map(async (p) => {
    const image = photographImage(p.id);
    const full = image ? (await getImage({ src: image, width: Math.min(2400, image.width), format: 'webp' })).src : null;
    return { ...p, image, full };
  }),
);
const shown = items.filter((p) => p.image);
const meta = (p: { year?: number; location?: string }) => [p.location, p.year].filter(Boolean).join(', ');
---

<Base
  title="Photography"
  description="Photography by Christopher Balogun (Ajiese), a Leicester-based artist working with portraiture, identity and culture."
  ogImage={shown[0]?.image}
>
  <section class="page-hero wrap">
    <div class="page-hero__top" data-reveal="fade">
      <p class="t-label">Photography</p>
      <span class="index">({String(shown.length).padStart(2, '0')})</span>
    </div>
    <Lines as="h1" class="t-display" lines={['Through the', '<em>lens.</em>']} />
    <p class="t-lead page-hero__lead" data-reveal="up" style="--d:0.3s">A developing collection of photographs by Ajiese.</p>
  </section>

  <section class="wrap photos" aria-label="Photographs">
    {
      shown.length > 0 ? (
        <ul class="photos__grid">
          {shown.map((p, i) => {
            const img = p.image!;
            const ratio = p.frame?.ratio ?? img.width / img.height;
            const pos = `${p.frame?.x ?? 50}% ${p.frame?.y ?? 50}%`;
            return (
              <li class="photo">
                <button
                  type="button"
                  class="photo__open"
                  data-lightbox-open={i}
                  data-full={p.full}
                  data-alt={p.alt}
                  data-title={p.title}
                  data-meta={meta(p)}
                  data-caption={p.caption ?? ''}
                  aria-label={`View ${p.title} full screen`}
                >
                  <span class="photo__frame" data-reveal="mask" style={`--d:${(i % 2) * 0.1}s;aspect-ratio:${ratio}`}>
                    <span class="media-inner photo__zoom">
                      <Picture
                        src={img}
                        alt={p.alt}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpg"
                        widths={[480, 800, 1200, 1600, img.width].filter((w, k, a) => w <= img.width && a.indexOf(w) === k)}
                        sizes="(max-width: 600px) 100vw, (max-width: 960px) 50vw, 45vw"
                        loading={i < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                        style={`object-position:${pos}`}
                      />
                    </span>
                  </span>
                </button>
                <div class="photo__meta" data-reveal="up" style={`--d:${(i % 2) * 0.1 + 0.15}s`}>
                  <span class="index">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h2 class="photo__title">{p.title}</h2>
                    {meta(p) && <p class="t-meta">{meta(p)}</p>}
                    {p.caption && <p class="photo__caption">{p.caption}</p>}
                  </div>
                  <span class="photo__cta" aria-hidden="true">View</span>
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <>
          <p class="notice" data-reveal="up">
            <span class="notice__tag">Layout preview</span>
            Photographs will be published here soon. The frames below show how they will appear.
          </p>
          <ul class="photos__grid" aria-hidden="true">
            {[3 / 2, 4 / 5, 4 / 5, 3 / 2].map((r, i) => (
              <li class="photo" data-reveal="up" style={`--d:${(i % 2) * 0.08}s`}>
                <Placeholder ratio={r} kicker="Photograph placeholder" label={r > 1 ? 'Landscape photograph' : 'Portrait photograph'} note="Photograph to be supplied" />
                <div class="photo__meta">
                  <p class="photo__title muted">Photograph title</p>
                  <p class="t-meta">Location, year</p>
                </div>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <section class="wrap photos-foot">
    <p class="t-meta">For prints, commissions or licensing enquiries, please get in touch.</p>
    <ArrowLink href="/contact?subject=Photography%20enquiry">Photography enquiries</ArrowLink>
  </section>

  {
    shown.length > 0 && (
      <dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
        <div class="lightbox__inner">
          <button type="button" class="lightbox__close" data-lightbox-close>
            Close <span aria-hidden="true">×</span>
          </button>
          <figure class="lightbox__figure">
            <img data-lightbox-img alt="" />
            <figcaption class="lightbox__cap">
              <span class="lightbox__title" data-lightbox-title />
              <span class="t-meta" data-lightbox-meta />
              <span class="lightbox__text" data-lightbox-caption />
            </figcaption>
          </figure>
          <div class="lightbox__nav">
            <button type="button" class="seq-btn" data-lightbox-prev aria-label="Previous photograph">←</button>
            <span class="index" data-lightbox-count />
            <button type="button" class="seq-btn" data-lightbox-next aria-label="Next photograph">→</button>
          </div>
        </div>
      </dialog>
    )
  }
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));
  if (dialog && triggers.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const set = (sel: string, text: string) => (dialog.querySelector(sel)!.textContent = text);
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + triggers.length) % triggers.length;
      const t = triggers[current].dataset;
      img.src = t.full || '';
      img.alt = t.alt || '';
      set('[data-lightbox-title]', t.title || '');
      set('[data-lightbox-meta]', t.meta || '');
      set('[data-lightbox-caption]', t.caption || '');
      set('[data-lightbox-count]', `${current + 1} / ${triggers.length}`);
    };

    triggers.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        opener = btn;
        show(i);
        dialog.showModal();
        document.documentElement.classList.add('lightbox-open');
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      opener?.focus();
    });
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // Click on the backdrop closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    const hide = triggers.length < 2;
    dialog.querySelector<HTMLElement>('.lightbox__nav')!.hidden = hide;
  }
</script>

<style>
  .notice {
    display: flex;
    gap: 14px;
    align-items: baseline;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--ink-70);
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .notice__tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    border: 1px solid currentColor;
    padding: 4px 8px;
  }

  /* Editorial grid, same rhythm as the homepage works: varied widths and offsets.
     Frames crop each photograph around its subject; the full view shows it whole. */
  .photos__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: clamp(72px, 9vw, 160px);
    align-items: start;
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .photo:nth-child(5n + 1) {
    grid-column: 1 / span 5;
  }
  .photo:nth-child(5n + 2) {
    grid-column: 7 / span 6;
    margin-top: clamp(80px, 14vw, 260px);
  }
  .photo:nth-child(5n + 3) {
    grid-column: 2 / span 4;
    margin-top: clamp(-140px, -5vw, 0px);
  }
  .photo:nth-child(5n + 4) {
    grid-column: 8 / span 5;
    margin-top: clamp(40px, 10vw, 180px);
  }
  .photo:nth-child(5n + 5) {
    grid-column: 4 / span 6;
  }
  .photo__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    text-align: left;
  }
  .photo__frame {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--white);
  }
  .photo__zoom {
    position: absolute;
    inset: 0;
    display: block;
  }
  .photo__zoom :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  .photo__open:hover .photo__zoom :global(img) {
    transform: scale(1.035);
  }
  .photo__meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 18px;
    padding-top: 18px;
  }
  .photo__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 32px);
    line-height: 1.1;
  }
  .photo__caption {
    font-size: 14px;
    color: var(--ink-70);
    max-width: 36em;
    margin-top: 6px;
  }
  .photo__cta {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.5s ease,
      transform 0.6s var(--ease-out);
  }
  .photo:hover .photo__cta {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .photo__cta {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .photo:nth-child(odd) {
      grid-column: 1 / span 6;
      margin-top: 0;
    }
    .photo:nth-child(even) {
      grid-column: 7 / span 6;
      margin-top: clamp(48px, 12vw, 120px);
    }
    /* a photo left alone on the last row is centred */
    .photo:nth-child(odd):last-child {
      grid-column: 4 / span 6;
    }
  }
  @media (max-width: 600px) {
    .photos__grid > .photo {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }

  .photos-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    padding-bottom: var(--section);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .lightbox::backdrop {
    background: rgb(23 23 23 / 0.6);
  }
  .lightbox[open] {
    animation: lb-in 0.5s var(--ease-out);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox__inner {
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 16px;
    padding: 16px var(--gutter) 24px;
  }
  .lightbox__close {
    justify-self: end;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 10px 0;
  }
  .lightbox__figure {
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 14px;
    justify-items: center;
  }
  .lightbox__figure img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    min-height: 0;
  }
  .lightbox__cap {
    display: grid;
    gap: 2px;
    text-align: center;
    max-width: 40em;
  }
  .lightbox__title {
    font-family: var(--serif);
    font-size: 22px;
  }
  .lightbox__text {
    font-size: 14px;
    color: var(--ink-70);
  }
  .lightbox__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }
  .seq-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    cursor: pointer;
    font-size: 16px;
  }
  .seq-btn:hover {
    background: var(--ink);
    color: var(--ivory);
  }
  :global(html.lightbox-open) {
    overflow: hidden;
  }
</style>
