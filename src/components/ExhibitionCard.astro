---
import type { Exhibition } from '../data/exhibitions';
import { fullTitle, getArtwork } from '../data/artworks';
import { exhibitionStatus, formatDateRange, place } from '../lib/format';

interface Props {
  exhibition: Exhibition;
  delay?: number;
}
const { exhibition: ex, delay = 0 } = Astro.props;
const status = exhibitionStatus(ex);
const art = getArtwork(ex.artwork);
---

<article class="ex-card" data-reveal="up" style={`--d:${delay}s`}>
  <a href={`/exhibitions/${ex.slug}`} class="ex-card__link">
    <div class="ex-card__head">
      <span class={`status status--${status.key}`}>{status.label}</span>
      <span class="t-meta">{formatDateRange(ex)}</span>
    </div>
    <h3 class="t-title ex-card__title">{ex.title}</h3>
    <dl class="ex-card__dl">
      {ex.organiser && ex.organiser !== ex.title && (<div><dt>Organiser</dt><dd>{ex.organiser}</dd></div>)}
      {ex.venue && (<div><dt>Venue</dt><dd>{ex.venue}{place(ex) && `, ${place(ex)}`}</dd></div>)}
      {art && (<div><dt>Work</dt><dd><em>{fullTitle(art)}</em></dd></div>)}
      {ex.statusNote && (<div><dt>Note</dt><dd>{ex.statusNote}</dd></div>)}
    </dl>
    <span class="ex-card__more" aria-hidden="true">Details →</span>
  </a>
</article>

<style>
  .ex-card {
    border-top: 1px solid var(--line-strong);
  }
  .ex-card__link {
    display: grid;
    gap: 20px;
    padding-top: 22px;
    height: 100%;
    align-content: start;
  }
  .ex-card__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ex-card__title {
    transition: transform 0.6s var(--ease-out);
  }
  .ex-card__link:hover .ex-card__title {
    transform: translateX(6px);
  }
  .ex-card__dl {
    display: grid;
    gap: 6px;
    font-size: 14px;
  }
  .ex-card__dl div {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 12px;
  }
  .ex-card__dl dt {
    color: var(--ink-55);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-top: 3px;
  }
  .ex-card__dl em {
    font-family: var(--serif);
    font-size: 1.15em;
  }
  .ex-card__more {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }
  .ex-card__link:hover .ex-card__more {
    opacity: 1;
  }
</style>
