---
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import { site } from '../data/site';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const details: [string, string, string?][] = [
  ['Artist', site.legalName],
  ['Artist name', site.name],
  ['Location', site.location],
  ['Email', site.email, `mailto:${site.email}`],
  ['Instagram', site.instagram.handle, site.instagram.url],
];
---

<Base
  title="Contact"
  description="Contact Christopher Balogun (Ajiese) about exhibitions, collaborations, commissions, artwork and print enquiries, or press features."
>
  <section class="page-hero wrap contact-hero">
    <div class="page-hero__top" data-reveal="fade">
      <p class="t-label">Contact</p>
      <span class="t-label muted">{site.locationShort}</span>
    </div>
    <Lines as="h1" class="t-display" lines={['Let’s talk', 'about <em>art.</em>']} />
    <p class="t-lead page-hero__lead" data-reveal="up" style="--d:0.3s">
      For exhibition opportunities, collaborations, artwork enquiries, press features or general conversations, I would
      be pleased to hear from you.
    </p>
  </section>

  <section class="wrap grid contact" aria-label="Contact details and form">
    <aside class="contact__info" data-reveal="up">
      <dl class="info-list">
        {
          details.map(([k, v, href]) => (
            <div>
              <dt class="t-label muted">{k}</dt>
              <dd>
                {href ? (
                  <a
                    href={href}
                    class="link-underline"
                    {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {v}
                    {href.startsWith('http') && <span aria-hidden="true"> ↗</span>}
                  </a>
                ) : (
                  v
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>

    <div class="contact__form" data-reveal="up" style="--d:0.12s">
      <form
        class="form"
        method="post"
        action={endpoint || undefined}
        novalidate
        data-contact-form
        data-endpoint={endpoint}
        data-email={site.email}
      >
        <div class="form__row form__row--half">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="f-name-err" />
            <p class="field__error" id="f-name-err" data-error-for="name"></p>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="f-email-err" />
            <p class="field__error" id="f-email-err" data-error-for="email"></p>
          </div>
        </div>
        <div class="field">
          <label for="f-subject">Subject</label>
          <input id="f-subject" name="subject" type="text" required maxlength="200" aria-describedby="f-subject-err" list="subject-options" />
          <datalist id="subject-options">
            <option value="Exhibition opportunity"></option>
            <option value="Collaboration"></option>
            <option value="Artwork enquiry"></option>
            <option value="Press enquiry"></option>
            <option value="General conversation"></option>
          </datalist>
          <p class="field__error" id="f-subject-err" data-error-for="subject"></p>
        </div>
        <div class="field">
          <label for="f-message">Message</label>
          <textarea id="f-message" name="message" rows="6" required minlength="10" maxlength="5000" aria-describedby="f-message-err"></textarea>
          <p class="field__error" id="f-message-err" data-error-for="message"></p>
        </div>

        <!-- Spam protection: honeypot (hidden from people) + minimum completion time -->
        <div class="hp" aria-hidden="true">
          <label for="f-company">Company</label>
          <input id="f-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form__foot">
          <p class="t-meta form__note">All fields are required. Your details are only used to reply to you.</p>
          <button type="submit" class="send" data-submit>
            <span data-submit-label>Send message</span>
            <span class="send__arrow" aria-hidden="true">→</span>
          </button>
        </div>
        <div class="form__status" role="status" aria-live="polite" data-status></div>
      </form>

      <div class="success" data-success hidden tabindex="-1">
        <p class="t-label muted">Thank you</p>
        <p class="t-heading success__title" data-success-title>Message sent.</p>
        <p class="t-body" data-success-text>Thank you for getting in touch. I will reply as soon as I can.</p>
        <button type="button" class="link-arrow" data-reset>Send another message <span class="arrow" aria-hidden="true">→</span></button>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const success = document.querySelector<HTMLElement>('[data-success]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const startedAt = Date.now();

    // Prefill subject from ?subject=
    const subjectParam = new URLSearchParams(location.search).get('subject');
    if (subjectParam) (form.elements.namedItem('subject') as HTMLInputElement).value = subjectParam.slice(0, 200);

    const messages: Record<string, (el: HTMLInputElement | HTMLTextAreaElement) => string> = {
      name: (el) => (el.validity.valueMissing ? 'Please enter your name.' : ''),
      email: (el) =>
        el.validity.valueMissing
          ? 'Please enter your email address.'
          : el.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)
            ? 'Please enter a valid email address, e.g. name@example.com.'
            : '',
      subject: (el) => (el.validity.valueMissing ? 'Please add a subject.' : ''),
      message: (el) =>
        el.validity.valueMissing
          ? 'Please write a message.'
          : el.validity.tooShort || el.value.trim().length < 10
            ? 'Please write a little more (at least 10 characters).'
            : '',
    };

    const fields = Object.keys(messages).map(
      (n) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement,
    );

    const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
      el.value = el.name === 'message' ? el.value : el.value.replace(/^\s+/, '');
      const msg = messages[el.name](el);
      const out = form.querySelector<HTMLElement>(`[data-error-for="${el.name}"]`)!;
      out.textContent = msg;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      el.closest('.field')?.classList.toggle('is-invalid', !!msg);
      return !msg;
    };

    fields.forEach((el) => {
      el.addEventListener('blur', () => el.value && check(el));
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el));
    });

    const showSuccess = (title: string, text: string) => {
      form.hidden = true;
      success.hidden = false;
      success.querySelector('[data-success-title]')!.textContent = title;
      success.querySelector('[data-success-text]')!.textContent = text;
      success.focus();
    };

    success.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      fields.forEach((el) => el.setAttribute('aria-invalid', 'false'));
      success.hidden = true;
      form.hidden = false;
      status.textContent = '';
      (fields[0] as HTMLElement).focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      const valid = fields.map(check);
      if (valid.includes(false)) {
        fields[valid.indexOf(false)].focus();
        status.textContent = 'Please check the highlighted fields.';
        return;
      }
      const data = new FormData(form);

      // Spam checks: filled honeypot or implausibly fast submission
      if ((data.get('_gotcha') as string)?.trim()) {
        showSuccess('Message sent.', 'Thank you for getting in touch.');
        return;
      }
      if (Date.now() - startedAt < 2500) {
        status.textContent = 'That was quick. Please check your message and send it again.';
        return;
      }

      const name = String(data.get('name')).trim();
      const subject = String(data.get('subject')).trim();
      const message = String(data.get('message')).trim();
      const from = String(data.get('email')).trim();

      if (!endpoint) {
        // No form service configured: hand over to the visitor's email app.
        const body = `${message}\n\n${name}\n${from}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showSuccess(
          'Almost there.',
          `Your email app should now open with your message ready to send. If nothing happens, please write to ${email}.`,
        );
        return;
      }

      submit.disabled = true;
      submitLabel.textContent = 'Sending…';
      try {
        data.delete('_gotcha');
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        showSuccess('Message sent.', 'Thank you for getting in touch. I will reply as soon as I can.');
      } catch {
        status.textContent = `Sorry, your message could not be sent. Please try again, or email ${email} directly.`;
      } finally {
        submit.disabled = false;
        submitLabel.textContent = 'Send message';
      }
    });
  }
</script>

<style>
  .contact {
    row-gap: 64px;
    padding-bottom: var(--section);
    align-items: start;
  }
  .contact__info {
    grid-column: 1 / span 4;
    display: grid;
    gap: 48px;
  }
  .contact__form {
    grid-column: 6 / -1;
  }
  @media (max-width: 960px) {
    .contact__info,
    .contact__form {
      grid-column: 1 / -1;
    }
    .contact__form {
      grid-row: 1;
    }
  }
  .info-list {
    border-top: 1px solid var(--line-strong);
  }
  .info-list > div {
    display: grid;
    grid-template-columns: 8.5em 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }
  .info-list dt {
    padding-top: 3px;
  }
  .info-list dd {
    word-break: break-word;
  }

  .form {
    display: grid;
    gap: 36px;
  }
  .form__row--half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px var(--col-gap);
  }
  @media (max-width: 560px) {
    .form__row--half {
      grid-template-columns: 1fr;
    }
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-55);
    transition: color 0.3s ease;
  }
  .field:focus-within label {
    color: var(--ink);
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: transparent;
    padding: 10px 0 12px;
    font-family: var(--serif);
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.3;
    border-radius: 0;
    transition: border-color 0.3s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .field textarea {
    resize: vertical;
    min-height: 9em;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--ink);
    box-shadow: 0 1px 0 0 var(--ink);
  }
  .field.is-invalid input,
  .field.is-invalid textarea {
    border-bottom-color: var(--rust);
    box-shadow: 0 1px 0 0 var(--rust);
  }
  .field__error {
    min-height: 1.2em;
    font-size: 13px;
    color: var(--rust);
  }
  .field__error:empty {
    min-height: 0;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .form__note {
    max-width: 24em;
  }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--ivory);
    padding: 20px 30px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.4s ease,
      color 0.4s ease;
  }
  .send:hover {
    background: transparent;
    color: var(--ink);
  }
  .send:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .send__arrow {
    transition: transform 0.5s var(--ease-out);
  }
  .send:hover .send__arrow {
    transform: translateX(5px);
  }
  .form__status {
    font-size: 14px;
    color: var(--rust);
  }
  .form__status:empty {
    display: none;
  }
  .success {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: 24px;
    border-top: 1px solid var(--line-strong);
  }
  .form[hidden],
  .success[hidden] {
    display: none;
  }
  .success:focus {
    outline: none;
  }
  .success button {
    background: none;
    border: 0;
    cursor: pointer;
    padding-inline: 0;
  }
</style>
