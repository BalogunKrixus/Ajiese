---
import { site } from '../data/site';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Lines from '../components/Lines.astro';
import { photographs } from '../data/photography';
import { photographImage } from '../lib/images';

// Only photographs whose file exists are shown.
const shown = photographs
  .map((p) => ({ ...p, image: photographImage(p.id) }))
  .filter((p): p is typeof p & { image: NonNullable<typeof p.image> } => Boolean(p.image));
---

<Base
  title="Photography"
  description="Photography by Christopher Balogun (Ajiese), a Leicester-based artist working with portraiture, identity and culture."
  ogImage={shown[0]?.image}
  ogImageAlt={shown[0]?.alt}
>
  <section class="page-hero wrap">
    <div class="page-hero__top" data-reveal="fade">
      <p class="t-label">Photography</p>
      <span class="index">({String(shown.length).padStart(2, '0')})</span>
    </div>
    <Lines as="h1" class="t-display" lines={['Through the', '<em>lens.</em>']} />
    <p class="t-lead page-hero__lead" data-reveal="up" style="--d:0.3s">A developing collection of photographs by Ajiese.</p>
  </section>

  <section class="wrap gallery" aria-label="Photographs">
    {
      shown.length > 0 ? (
        <ul class="gallery__grid">
          {shown.map((p, i) => (
            <li class="gallery__item" data-reveal="mask" style={`--d:${(i % 3) * 0.08}s`}>
              <div class="media-inner">
                <Picture
                  src={p.image}
                  alt={p.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 800, 1200, 1600, p.image.width].filter((w, k, a) => w <= p.image.width && a.indexOf(w) === k)}
                  sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="t-meta">Photographs will be published here soon.</p>
      )
    }
  </section>

  <section class="wrap photos-foot">
    <p class="t-meta">For prints, commissions or licensing enquiries, please get in touch.</p>
    <ArrowLink href={`mailto:${site.email}?subject=${encodeURIComponent('Photography enquiry')}`}>Photography enquiries</ArrowLink>
  </section>
</Base>

<style>
  /* Gallery: a masonry of whole, uncropped photographs that grows as photos are added. */
  .gallery {
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .gallery__grid {
    columns: 3;
    column-gap: clamp(16px, 2.2vw, 36px);
  }
  .gallery__item {
    break-inside: avoid;
    margin-bottom: clamp(16px, 2.2vw, 36px);
    overflow: hidden;
    background: var(--white);
  }
  .gallery__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 1100px) {
    .gallery__grid {
      columns: 2;
    }
  }
  @media (max-width: 600px) {
    .gallery__grid {
      columns: 1;
    }
  }

  .photos-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    padding-bottom: var(--section);
  }
</style>
