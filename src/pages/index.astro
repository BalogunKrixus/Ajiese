---
import Base from '../layouts/Base.astro';
import ArtImage from '../components/ArtImage.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Lines from '../components/Lines.astro';
import WorkCard from '../components/WorkCard.astro';
import ExhibitionCard from '../components/ExhibitionCard.astro';
import { artworks, fullTitle } from '../data/artworks';
import { exhibitions } from '../data/exhibitions';
import { site } from '../data/site';
import { artistPortrait, artworkImage } from '../lib/images';
import { letters, sortExhibitions } from '../lib/format';
import { collectionSchema } from '../lib/schema';

const heroWork = artworks[0];
const heroImage = artworkImage(heroWork.slug);
const heroRatio = heroImage ? heroImage.width / heroImage.height : heroWork.placeholderRatio;
const portrait = artistPortrait();
const featuredExhibitions = sortExhibitions(exhibitions.filter((e) => e.status !== 'selected')).slice(0, 3);
---

<Base
  fullTitle="Ajiese (Christopher Balogun) | Contemporary Artist, Leicester"
  description={site.defaultDescription}
  ogImage={heroImage}
  ogImageAlt={heroWork.alt}
  jsonLd={collectionSchema(artworks, Astro.site!, '/', 'Ajiese (Christopher Balogun): selected works')}
  bodyClass="page-home"
>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <div class="hero__top">
        <p class="t-label hero__fade" style="--d:0.95s">Contemporary artist / {site.locationShort}</p>
        <p class="t-label hero__fade hero__descriptor" style="--d:1.05s">{site.descriptor}</p>
      </div>

      <div class="hero__body">
        <p class="hero__statement" aria-label="Art, identity and the language of form.">
          <span class="line" aria-hidden="true"><span style="--i:0">Art, identity</span></span>
          <span class="line" aria-hidden="true"><span style="--i:1">and the language</span></span>
          <span class="line" aria-hidden="true"><span style="--i:2">of <em>form.</em></span></span>
        </p>

        <figure class="hero__art" style={`--ratio:${heroRatio}`} data-drift="0.05">
          <figcaption class="hero__caption hero__fade" style="--d:2s">
            <span class="index">01</span>
            <span><em>{heroWork.title}</em>, {heroWork.year}</span>
          </figcaption>
          <a href={`/work/${heroWork.slug}`} class="hero__art-link" aria-label={`View ${fullTitle(heroWork)}`}>
            <div class="hero__art-mask">
              <div class="hero__art-inner">
                <ArtImage
                  image={heroImage}
                  alt={heroWork.alt}
                  label={heroWork.title}
                  kicker="Artwork image placeholder"
                  note="Original artwork file to be supplied"
                  ratio={heroWork.placeholderRatio}
                  sizes="(max-width: 760px) 70vw, 30vw"
                  eager
                  compact
                />
              </div>
            </div>
          </a>
        </figure>

        <div class="hero__aside">
          <p class="hero__intro hero__fade" style="--d:1.6s">
            An evolving body of work exploring people, cultural references and visual memory through contemporary
            digital portraiture.
          </p>
          <a href="#selected-works" class="hero__scroll hero__fade t-label" style="--d:1.9s">
            <span>Scroll to explore</span>
            <span class="hero__scroll-arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <h1 class="hero__word" id="hero-title">
        <span class="sr-only">Ajiese (Christopher Balogun), contemporary artist</span>
        <span class="hero__letters" aria-hidden="true">
          {
            letters(site.wordmark).map((ch, i) => (
              <span class="ch">
                <span style={`--i:${i}`}>{ch}</span>
              </span>
            ))
          }
        </span>
      </h1>
    </div>
  </section>

  <!-- ============ SELECTED WORKS ============ -->
  <section class="section works" id="selected-works" aria-labelledby="works-title">
    <div class="wrap">
      <header class="grid section-head">
        <div class="section-head__label">
          <h2 class="t-label" id="works-title">Selected works</h2>
          <span class="index">({String(artworks.length).padStart(2, '0')})</span>
        </div>
        <Lines
          as="p"
          class="t-lead section-head__lead"
          lines={['A selection of works exploring identity,', 'culture, memory and <em>human connection.</em>']}
        />
      </header>

      <div class="works__grid">
        {artworks.map((a, i) => <WorkCard artwork={a} index={i + 1} transition class="works__item" />)}
      </div>

      <div class="works__foot">
        <ArrowLink href="/work">View all works</ArrowLink>
      </div>
    </div>
  </section>

  <!-- ============ ARTIST INTRODUCTION ============ -->
  <section class="section intro surface-white" aria-labelledby="intro-title">
    <div class="wrap grid intro__grid">
      <div class="intro__media" data-reveal="mask">
        <div class="media-inner">
          <ArtImage
            image={portrait}
            alt="Portrait of the artist Christopher Balogun (Ajiese)"
            label="Artist portrait"
            kicker="Photograph placeholder"
            note="Professional portrait of the artist to be supplied"
            ratio={4 / 5}
            sizes="(max-width: 760px) 100vw, 40vw"
          />
        </div>
      </div>
      <div class="intro__text">
        <p class="t-label muted" data-reveal="fade">The artist</p>
        <Lines id="intro-title" class="t-heading" lines={['A practice', 'rooted in <em>identity.</em>']} />
        <div class="t-body" data-reveal="up" style="--d:0.2s">
          <p>
            I am Christopher Balogun, a Leicester-based artist working under the name Ajiese. My practice explores
            identity, culture and memory through contemporary digital portraiture.
          </p>
          <p>
            Through geometric forms, colour, pattern and visual distortion, I reconstruct familiar people and cultural
            references into expressive compositions that sit between representation and abstraction.
          </p>
        </div>
        <div data-reveal="up" style="--d:0.3s">
          <ArrowLink href="/about">More about the artist</ArrowLink>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EXHIBITIONS ============ -->
  <section class="section surface-dark beyond" aria-labelledby="beyond-title">
    <div class="wrap">
      <header class="grid section-head">
        <div class="section-head__label">
          <p class="t-label">Exhibitions</p>
          <span class="index">2026</span>
        </div>
        <Lines id="beyond-title" class="t-heading section-head__lead" lines={['Beyond the <em>studio.</em>']} />
      </header>
      <div class="beyond__grid">
        {featuredExhibitions.map((ex, i) => <ExhibitionCard exhibition={ex} delay={i * 0.1} />)}
      </div>
      <div class="works__foot">
        <ArrowLink href="/exhibitions">View exhibitions</ArrowLink>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT INVITATION ============ -->
  <section class="section connect" aria-labelledby="connect-title">
    <div class="wrap grid">
      <p class="t-label muted connect__label" data-reveal="fade">Contact</p>
      <div class="connect__body">
        <Lines id="connect-title" class="t-display" lines={['Let’s', '<em>connect.</em>']} />
        <p class="t-lead connect__copy" data-reveal="up" style="--d:0.2s">
          For exhibition opportunities, collaborations, artwork enquiries or general conversations, I would love to
          hear from you.
        </p>
        <div class="connect__links" data-reveal="up" style="--d:0.3s">
          <ArrowLink href={`mailto:${site.email}`}>Email the artist</ArrowLink>
          <ArrowLink href={site.instagram.url} external>Instagram</ArrowLink>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    /* sized by width and height, so the whole wordmark (J included) fits the first screen */
    --art-h: min(46svh, 40vw);
    --word-size: min(27vw, 38svh);
    min-height: 100svh;
    display: flex;
    padding-top: var(--nav-h);
    /* clip sideways only, so nothing below the baseline (the J) is ever cut */
    overflow-x: clip;
  }
  .hero__inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - var(--nav-h));
  }
  .hero__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: clamp(16px, 2.4vh, 32px);
    border-top: 1px solid var(--line);
    padding-block-start: 18px;
  }
  .hero__body {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: end;
    padding-top: clamp(24px, 4vh, 56px);
  }
  .hero__statement {
    grid-column: 1 / span 5;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(34px, 3.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.015em;
    padding-bottom: clamp(24px, 3vw, 48px);
  }
  .hero__statement em {
    font-style: italic;
  }
  .hero__art {
    grid-column: 6 / span 3;
    justify-self: center;
    width: calc(var(--art-h) * var(--ratio));
    max-width: 100%;
    margin-bottom: calc(var(--word-size) * -0.3);
    transform: translateY(var(--drift, 0px));
    position: relative;
  }
  .hero__art-link {
    display: block;
  }
  .hero__art-mask {
    overflow: hidden;
  }
  .hero__art-inner {
    transition: transform 1.4s var(--ease-out);
  }
  .hero__art-link:hover .hero__art-inner {
    transform: scale(1.03);
  }
  .hero__caption {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 10px;
    font-size: 13px;
  }
  .hero__caption em {
    font-family: var(--serif);
    font-size: 16px;
  }
  .hero__aside {
    grid-column: 10 / span 3;
    display: grid;
    gap: 28px;
    padding-bottom: clamp(24px, 3vw, 48px);
  }
  .hero__intro {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-70);
    max-width: 24em;
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: max-content;
  }
  .hero__scroll-arrow {
    display: inline-block;
    animation: nudge 2.4s var(--ease-in-out) 3s infinite;
  }
  @keyframes nudge {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(5px);
    }
  }

  .hero__word {
    position: relative;
    z-index: 1;
    margin: 0 -0.02em;
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--word-size);
    line-height: 0.7;
    letter-spacing: -0.035em;
    text-align: center;
    white-space: nowrap;
    /* leave room below the baseline for the tail of the J */
    padding-bottom: 0.42em;
  }
  .hero__letters {
    display: flex;
    justify-content: center;
    /* tracking grows a little with the screen, but the word stays one word */
    gap: clamp(0.02em, calc((100vw - 4.1 * var(--word-size)) / 6), 0.16em);
  }
  .hero__letters .ch {
    display: inline-block;
    overflow: hidden;
    /* the reveal mask must include descenders (the J) */
    padding-top: 0.08em;
    padding-bottom: 0.5em;
    margin-bottom: -0.5em;
  }
  .hero__letters .ch > span {
    display: inline-block;
  }

  /* Opening sequence */
  :global(html.js) .hero__letters .ch > span {
    animation: rise 1.25s var(--ease-mask) both;
    animation-delay: calc(0.15s + var(--i) * 0.075s);
  }
  :global(html.js) .hero__statement .line > span {
    animation: rise 1.1s var(--ease-mask) both;
    animation-delay: calc(1.05s + var(--i) * 0.09s);
  }
  :global(html.js) .hero__fade {
    animation: fade-up 1s var(--ease-out) both;
    animation-delay: var(--d, 1s);
  }
  :global(html.js) .hero__art-mask {
    animation: mask-up 1.5s var(--ease-mask) 0.9s both;
  }
  :global(html.js) .hero__art-mask .hero__art-inner {
    animation: settle 2.2s var(--ease-out) 0.9s both;
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes mask-up {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.18);
    }
    to {
      transform: scale(1);
    }
  }

  @media (max-width: 1100px) {
    .hero__statement {
      grid-column: 1 / span 6;
    }
    .hero__art {
      grid-column: 7 / span 3;
    }
    .hero__aside {
      grid-column: 10 / span 3;
    }
  }
  @media (max-width: 860px) {
    .hero {
      --art-h: 52svh;
    }
    .hero__descriptor {
      display: none;
    }
    .hero__inner {
      grid-template-rows: auto auto 1fr;
    }
    .hero__body {
      grid-row: 3;
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
      align-items: start;
      padding-top: 28px;
    }
    .hero__word {
      grid-row: 2;
      margin-top: clamp(32px, 7vh, 72px);
      line-height: 0.74;
    }
    .hero__statement {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: clamp(30px, 8vw, 48px);
      padding-bottom: 0;
    }
    .hero__art {
      grid-column: 1 / -1;
      grid-row: 3;
      justify-self: stretch;
      width: auto;
      margin-bottom: 0;
      transform: none;
    }
    .hero__aside {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-bottom: 8px;
    }
  }

  /* ---------------- Section heads ---------------- */
  .section-head {
    align-items: end;
    row-gap: 24px;
    margin-bottom: clamp(56px, 8vw, 128px);
  }
  .section-head__label {
    grid-column: 1 / span 4;
    display: flex;
    gap: 14px;
    align-items: baseline;
    align-self: start;
    padding-top: 0.6em;
  }
  .section-head__lead {
    grid-column: 5 / -1;
  }
  @media (max-width: 760px) {
    .section-head__label,
    .section-head__lead {
      grid-column: 1 / -1;
    }
  }

  /* ---------------- Works grid ---------------- */
  .works__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: clamp(72px, 9vw, 160px);
    align-items: start;
  }
  .works__grid > :global(.works__item:nth-child(4n + 1)) {
    grid-column: 1 / span 6;
  }
  .works__grid > :global(.works__item:nth-child(4n + 2)) {
    grid-column: 8 / span 5;
    margin-top: clamp(80px, 16vw, 300px);
  }
  .works__grid > :global(.works__item:nth-child(4n + 3)) {
    grid-column: 2 / span 5;
    margin-top: clamp(-160px, -6vw, 0px);
  }
  .works__grid > :global(.works__item:nth-child(4n + 4)) {
    grid-column: 8 / span 5;
    margin-top: clamp(40px, 10vw, 200px);
  }
  .works__foot {
    display: flex;
    justify-content: center;
    margin-top: clamp(72px, 9vw, 140px);
  }
  @media (max-width: 760px) {
    .works__grid > :global(.works__item) {
      grid-column: 1 / -1 !important;
      margin-top: 0 !important;
    }
  }

  /* ---------------- Intro ---------------- */
  .intro__grid {
    align-items: center;
    row-gap: 48px;
  }
  .intro__media {
    grid-column: 1 / span 5;
  }
  .intro__text {
    grid-column: 7 / span 6;
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    justify-items: start;
  }
  @media (max-width: 860px) {
    .intro__media,
    .intro__text {
      grid-column: 1 / -1;
    }
  }

  /* ---------------- Beyond the studio ---------------- */
  .beyond__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 3vw, 56px);
  }
  @media (max-width: 960px) {
    .beyond__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- Connect ---------------- */
  .connect__label {
    grid-column: 1 / span 3;
    padding-top: 1.4em;
  }
  .connect__body {
    grid-column: 4 / -1;
    display: grid;
    gap: clamp(28px, 3vw, 44px);
  }
  .connect__links {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }
  @media (max-width: 760px) {
    .connect__label,
    .connect__body {
      grid-column: 1 / -1;
    }
  }
</style>
