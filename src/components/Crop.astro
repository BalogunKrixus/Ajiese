---
/**
 * A close-up view of an artwork: either a separately supplied detail image,
 * an enlarged crop of the original file (no alteration — the browser simply
 * magnifies part of the image), or a labelled placeholder.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import type { DetailCrop } from '../data/artworks';

interface Props {
  image?: ImageMetadata;
  crop: DetailCrop;
  alt: string;
  ratio?: number;
  placeholderLabel?: string;
}
const { image, crop: c, alt, ratio = 4 / 5, placeholderLabel } = Astro.props;
---

{
  image ? (
    <div class="crop" style={`aspect-ratio:${ratio}`}>
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[800, 1400, 2000, image.width].filter((w, i, arr) => w <= image.width && arr.indexOf(w) === i)}
        sizes={`${Math.min(100, Math.round(c.zoom * 40))}vw`}
        loading="lazy"
        decoding="async"
        style={`object-position:${c.x}% ${c.y}%;transform-origin:${c.x}% ${c.y}%;transform:scale(${c.zoom})`}
      />
    </div>
  ) : (
    <Placeholder ratio={ratio} kicker="Close-up — placeholder" label={placeholderLabel ?? c.caption} note="Detail image to be supplied" />
  )
}

<style>
  .crop {
    position: relative;
    overflow: hidden;
    background: var(--white);
  }
  .crop :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
