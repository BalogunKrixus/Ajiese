---
import { navigation, site } from '../data/site';
import { letters } from '../lib/format';
const year = new Date().getFullYear();
---

<footer class="footer surface-dark">
  <div class="wrap">
    <div class="grid footer__top">
      <div class="footer__intro">
        <p class="t-label muted">{site.descriptor}</p>
        <p class="t-lead footer__statement">
          Exploring identity, culture and memory through <em>contemporary digital portraiture.</em>
        </p>
      </div>
      <div class="footer__col">
        <p class="t-label muted">Studio</p>
        <ul>
          <li>{site.location}</li>
          <li><a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a class="link-underline" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
              Instagram {site.instagram.handle} ↗
            </a>
          </li>
        </ul>
      </div>
      <nav class="footer__col" aria-label="Footer">
        <p class="t-label muted">Index</p>
        <ul>
          {navigation.map((n) => <li><a class="link-underline" href={n.href}>{n.label}</a></li>)}
          <li><a class="link-underline" href="/work">All works</a></li>
        </ul>
      </nav>
    </div>

    <p class="footer__mark" aria-hidden="true" data-reveal="lines">
      <span class="line"><span>{letters(site.wordmark).join('')}</span></span>
    </p>

    <div class="footer__base">
      <p>© {year} {site.legalName}. All artworks © the artist.</p>
      <a href="#top" class="link-underline" data-to-top>Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(80px, 10vw, 160px);
    overflow: hidden;
  }
  .footer__top {
    row-gap: 48px;
    padding-bottom: clamp(56px, 8vw, 120px);
  }
  .footer__intro {
    grid-column: 1 / span 6;
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .footer__statement {
    max-width: 18em;
  }
  .footer__col {
    grid-column: span 3;
    display: grid;
    gap: 20px;
    align-content: start;
    font-size: 15px;
  }
  .footer__col ul {
    display: grid;
    gap: 8px;
  }
  .footer__mark {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 25.4vw;
    line-height: 0.74;
    letter-spacing: -0.02em;
    margin-inline: -0.06em;
    text-align: center;
    padding-top: 0.06em;
    padding-bottom: 0.45em;
    color: var(--ivory);
    user-select: none;
  }
  .footer__mark .line {
    padding-bottom: 0.5em;
    margin-bottom: -0.5em;
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-block: 22px 28px;
    font-size: 12px;
    color: var(--ink-55);
  }
  @media (max-width: 860px) {
    .footer__intro {
      grid-column: 1 / -1;
    }
    .footer__col {
      grid-column: span 6;
    }
  }
  @media (max-width: 520px) {
    .footer__col {
      grid-column: 1 / -1;
    }
  }
</style>
