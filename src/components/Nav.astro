---
import { navigation, site } from '../data/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label="Ajiese — home">{site.wordmark}</a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link link-underline"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={site.instagram.url} class="nav__ig" target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${site.instagram.handle} (opens in a new tab)`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="menu-btn__text" data-open-label>Menu</span>
      <span class="menu-btn__text" data-close-label>Close</span>
      <span class="menu-btn__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <div class="wrap mobile-menu__inner">
    <p class="t-label muted mobile-menu__kicker">{site.descriptor}</p>
    <nav aria-label="Mobile">
      <ul class="mobile-menu__list">
        {
          navigation.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <span class="mobile-menu__word">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <a href={`mailto:${site.email}`} class="link-underline">{site.email}</a>
      <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="link-underline">
        Instagram {site.instagram.handle} ↗
      </a>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    view-transition-name: site-header;
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.5s ease,
      border-color 0.5s ease;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-color: var(--line);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1;
    padding-block: 8px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 44px);
  }
  .nav__list {
    display: flex;
    gap: clamp(18px, 2.4vw, 40px);
  }
  .nav__link {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-block: 6px;
    opacity: 0.72;
    transition:
      opacity 0.4s ease,
      background-size 0.6s var(--ease-out);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    opacity: 1;
  }
  .nav__ig {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease;
  }
  .nav__ig:hover {
    background: var(--ink);
    color: var(--ivory);
    border-color: var(--ink);
  }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 12px;
    border: 0;
    background: none;
    padding: 10px 0 10px 10px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .menu-btn [data-close-label],
  .menu-btn[aria-expanded='true'] [data-open-label] {
    display: none;
  }
  .menu-btn[aria-expanded='true'] [data-close-label] {
    display: inline;
  }
  .menu-btn__icon {
    position: relative;
    width: 22px;
    height: 10px;
  }
  .menu-btn__icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.2px;
    background: currentColor;
    transition:
      transform 0.6s var(--ease-mask),
      top 0.6s var(--ease-mask);
  }
  .menu-btn__icon span:first-child {
    top: 0;
  }
  .menu-btn__icon span:last-child {
    top: 9px;
  }
  .menu-btn[aria-expanded='true'] .menu-btn__icon span:first-child {
    top: 4.5px;
    transform: rotate(20deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__icon span:last-child {
    top: 4.5px;
    transform: rotate(-20deg);
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--paper);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-mask);
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }
  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
  }
  .mobile-menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-h) + 6vh);
    padding-bottom: 32px;
  }
  .mobile-menu__kicker {
    margin-bottom: 4vh;
  }
  .mobile-menu__list li {
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .mobile-menu__list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    /* bottom room for descenders (p, g, y) inside the reveal mask */
    padding-block: 10px 26px;
    margin-bottom: -14px;
    transform: translateY(110%);
    transition: transform 0.9s var(--ease-mask);
    transition-delay: calc(0.12s + var(--i) * 0.06s);
  }
  .mobile-menu.is-open .mobile-menu__list a {
    transform: none;
  }
  .mobile-menu__word {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 13vw, 84px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .mobile-menu__list a[aria-current='page'] .mobile-menu__word {
    font-style: italic;
  }
  .mobile-menu__foot {
    margin-top: auto;
    padding-top: 40px;
    display: grid;
    gap: 8px;
    font-size: 14px;
    opacity: 0;
    transition: opacity 0.6s ease 0.5s;
  }
  .mobile-menu.is-open .mobile-menu__foot {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .site-header__inner {
      height: 64px;
    }
  }
  :global(html.menu-open) .site-header {
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: none;
  }
</style>
